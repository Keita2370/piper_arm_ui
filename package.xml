<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>piper_arm_ui</name>
  <version>0.4.0</version>
  <description>
    PiPER アームロボット用のブラウザ操作UI (WebRTC映像 + rosbridge).
    犬型ロボット搭載アームによるレモン自動収穫デモ向け.
  </description>
  <maintainer email="hagihara516@gmail.com">keita</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <!-- メッシュ簡略化（urdf_scene）と座標指定の逆運動学（kinematics）で使う -->
  <depend>python3-numpy</depend>

  <!-- 起動時に必要 (rosdep で入らない場合は apt/pip で導入) -->
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>rviz_default_plugins</exec_depend>
  <!-- RealSense。realsense2_camera が無くても launch は通る -->
  <exec_depend>realsense2_camera</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
